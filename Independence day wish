# STAGE 3: GitHub Actions Workflow
mkdir -p .github/workflows
cat << 'EOF' > .github/workflows/independence_day.yml
name: Independence Day Greeting

on:
  schedule:
    - cron: '0 0 15 8 *'
  workflow_dispatch:

jobs:
  celebrate:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Print Terminal Tricolor Banner
        run: |
          echo -e "\033[48;2;255;153;51m\033[38;2;255;255;255m                                                      \033[0m"
          echo -e "\033[48;2;255;153;51m\033[38;2;255;255;255m             HAPPY INDEPENDENCE DAY 🇮🇳                \033[0m"
          echo -e "\033[48;2;255;153;51m\033[38;2;255;255;255m                                                      \033[0m"
          echo -e "\033[48;2;255;255;255m\033[38;2;0;0;128m                 ⚙️  JAI HIND  ⚙️                       \033[0m"
          echo -e "\033[48;2;19;136;8m\033[38;2;255;255;255m                                                      \033[0m"
          echo -e "\033[48;2;19;136;8m\033[38;2;255;255;255m             VANDE MATARAM - AUG 15                   \033[0m"
          echo -e "\033[48;2;19;136;8m\033[38;2;255;255;255m                                                      \033[0m"
EOF

# STAGE 4: Git Commit Message Hook
mkdir -p .git/hooks
cat << 'EOF' > .git/hooks/prepare-commit-msg
#!/bin/bash

COMMIT_MSG_FILE=$1
COMMIT_SOURCE=$2
SHA1=$3

CURRENT_DATE=$(date +%m-%d)

if [ "$CURRENT_DATE" == "08-15" ]; then
    EXISTING_MSG=$(cat "$COMMIT_MSG_FILE")
    echo "🇮🇳 [Happy Independence Day] $EXISTING_MSG" > "$COMMIT_MSG_FILE"
fi
EOF
chmod +x .git/hooks/prepare-commit-msg

